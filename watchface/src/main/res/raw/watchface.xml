<?xml version="1.0" encoding="UTF-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="18:38:00" />

    <Scene backgroundColor="#FF050707">
        <!-- Interactive face -->
        <Group x="0" y="0" width="450" height="450" alpha="255" name="interactive_face">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- Spot -->
            <PartText x="100" y="18" width="250" height="34">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="20" weight="MEDIUM" color="#FF74D9D4">label_open_data</Font>
                </Text>
            </PartText>

            <!-- Main time -->
            <DigitalClock x="28" y="48" width="394" height="88">
                <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="394" height="88">
                    <Font family="SYNC_TO_DEVICE" size="92" weight="MEDIUM" color="#FFF2EFE7" />
                </TimeText>
            </DigitalClock>

            <!-- Tide instrument panel -->
            <PartDraw x="30" y="143" width="390" height="148">
                <RoundRectangle x="0" y="0" width="390" height="148" cornerRadiusX="18" cornerRadiusY="18">
                    <Stroke thickness="2" color="#FF3A4240" />
                </RoundRectangle>
                <Rectangle x="194" y="18" width="2" height="58">
                    <Fill color="#FF3A4240" />
                </Rectangle>
                <Rectangle x="20" y="83" width="350" height="1">
                    <Fill color="#FF29302F" />
                </Rectangle>
            </PartDraw>

            <PartText x="50" y="153" width="120" height="25">
                <Text align="START">
                    <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF74D9D4">label_tide</Font>
                </Text>
            </PartText>
            <PartText x="48" y="174" width="150" height="54">
                <Text align="START">
                    <Font family="SYNC_TO_DEVICE" size="48" weight="MEDIUM" color="#FF829394">placeholder_value</Font>
