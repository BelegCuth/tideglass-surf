            <PartText x="230" y="153" width="160" height="25">
                <Text align="START">
                    <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF74D9D4">label_next_high</Font>
                </Text>
            </PartText>
            <PartText x="230" y="180" width="160" height="43">
                <Text align="START">
                    <Font family="SYNC_TO_DEVICE" size="38" weight="MEDIUM" color="#FF829394">placeholder_time</Font>
                </Text>
            </PartText>

            <!-- Neutral fallback shown until the live Tideglass curve provider is available. -->
            <PartDraw x="52" y="246" width="346" height="1">
                <Rectangle x="0" y="0" width="346" height="1"><Fill color="#FF29302F" /></Rectangle>
            </PartDraw>
            <PartText x="52" y="253" width="346" height="24">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" weight="MEDIUM" color="#FF829394">label_live_data</Font></Text>
            </PartText>

            <!-- Surf and wind summary -->
            <PartDraw x="224" y="311" width="2" height="67">
                <Rectangle x="0" y="0" width="2" height="67"><Fill color="#FF3A4240" /></Rectangle>
            </PartDraw>
            <PartText x="46" y="302" width="165" height="25">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF74D9D4">label_surf</Font></Text>
            </PartText>
            <PartText x="42" y="328" width="172" height="48">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" weight="MEDIUM" color="#FF829394">placeholder_surf</Font></Text>
            </PartText>
            <PartText x="239" y="302" width="165" height="25">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF74D9D4">label_wind</Font></Text>
            </PartText>
            <PartText x="236" y="328" width="172" height="48">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" weight="MEDIUM" color="#FF829394">placeholder_value</Font></Text>
