            <ComplicationSlot x="236" y="328" width="172" height="48" slotId="5" displayName="wind_slot_label" supportedTypes="SHORT_TEXT EMPTY">
                <BoundingRoundBox x="0" y="0" width="172" height="48" cornerRadius="10" outlinePadding="2" />
                <DefaultProviderPolicy primaryProvider="com.tideglass.surf.provider/com.tideglass.surf.provider.complications.WindComplicationService" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
                <Complication type="SHORT_TEXT">
                    <PartDraw x="0" y="0" width="172" height="48"><Rectangle x="0" y="0" width="172" height="48"><Fill color="#FF050707" /></Rectangle></PartDraw>
                    <PartText x="0" y="0" width="172" height="48"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="30" weight="MEDIUM" color="#FFF2EFE7"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
                </Complication>
            </ComplicationSlot>

            <ComplicationSlot x="52" y="242" width="346" height="44" slotId="6" displayName="tide_graph_slot_label" supportedTypes="SMALL_IMAGE EMPTY">
                <BoundingRoundBox x="0" y="0" width="346" height="44" cornerRadius="8" outlinePadding="2" />
                <DefaultProviderPolicy primaryProvider="com.tideglass.surf.provider/com.tideglass.surf.provider.complications.TideGraphComplicationService" primaryProviderType="SMALL_IMAGE" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
                <Complication type="SMALL_IMAGE">
                    <PartImage x="0" y="0" width="346" height="44">
                        <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                    </PartImage>
                </Complication>
            </ComplicationSlot>
        <!-- Burn-in-friendly ambient face. -->
        <Group x="0" y="0" width="450" height="450" alpha="0" name="ambient_face">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <DigitalClock x="28" y="142" width="394" height="96">
                <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="394" height="96">
