            <PartText x="110" y="389" width="230" height="35">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" weight="MEDIUM" color="#FFFF756B">label_forecast_notice</Font></Text>
            </PartText>
        </Group>

        <!-- Editable live-data slots. Neutral placeholders above prevent stale or sample values being mistaken for forecasts. -->
            <ComplicationSlot x="100" y="18" width="250" height="34" slotId="1" displayName="spot_slot_label" supportedTypes="SHORT_TEXT EMPTY">
                <BoundingRoundBox x="0" y="0" width="250" height="34" cornerRadius="12" outlinePadding="2" />
                <DefaultProviderPolicy primaryProvider="com.tideglass.surf.provider/com.tideglass.surf.provider.complications.SpotComplicationService" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
                <Complication type="SHORT_TEXT">
                    <PartDraw x="0" y="0" width="250" height="34"><Rectangle x="0" y="0" width="250" height="34"><Fill color="#FF050707" /></Rectangle></PartDraw>
                    <PartText x="0" y="0" width="250" height="34"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="24" weight="MEDIUM" color="#FF74D9D4"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
                </Complication>
            </ComplicationSlot>

            <ComplicationSlot x="48" y="174" width="150" height="54" slotId="2" displayName="tide_slot_label" supportedTypes="SHORT_TEXT EMPTY">
                <BoundingRoundBox x="0" y="0" width="150" height="54" cornerRadius="10" outlinePadding="2" />
                <DefaultProviderPolicy primaryProvider="com.tideglass.surf.provider/com.tideglass.surf.provider.complications.TideComplicationService" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
