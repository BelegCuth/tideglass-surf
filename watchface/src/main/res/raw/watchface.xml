                    <PartText x="0" y="0" width="160" height="43"><Text align="START"><Font family="SYNC_TO_DEVICE" size="34" weight="MEDIUM" color="#FFF2EFE7"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
